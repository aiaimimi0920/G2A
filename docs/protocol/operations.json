      "category": "authentication",
      "retry": "after_reauth",
      "http_status": 401,
      "outcome": "not_accepted"
    },
    "stale_transport": {
      "category": "authentication",
      "retry": "after_reauth",
      "http_status": 401,
      "outcome": "not_accepted"
    },
