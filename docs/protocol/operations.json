{
  "design_revision": "g2a-design-1",
  "not_a_wire_version": true,
  "operations": {
    "describe": {
      "roles": [
        "agent",
        "player"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "read",
      "input": "describe_input",
      "output": "describe_output",
      "semantic_guard": "验证 endpoint 身份并按主体过滤；公开发现只返回 PublicDescriptor，不调用此完整描述接口。"
    },
    "offer.create": {
      "roles": [
        "agent",
        "player"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "offer_create_input",
      "output": "offer_create_output",
      "semantic_guard": "companion 入口 actor=agent；game 入口为玩家或经验证委托；固定 Scope 后不能替换身份。"
    },
    "offer.get": {
      "roles": [
        "agent",
        "player"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "read",
      "input": "offer_get_input",
      "output": "offer_get_output",
      "semantic_guard": "仅绑定主体可读。"
    },
    "offer.decide": {
      "roles": [
        "player"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "offer_decide_input",
      "output": "offer_decide_output",
      "semantic_guard": "decision_ref 验证真实玩家交互；remember=true 必须同时提供规则期限与授权时长，false 禁止两字段；拒绝时两许可均为 false。"
    },
    "invitation.redeem": {
      "roles": [
        "agent"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "invitation_redeem_input",
      "output": "invitation_redeem_output",
      "semantic_guard": "仅 scope.agent；同 intent 重试；邀请秘密只交本人，绑定 Scope、玩家、实例及设备。"
    },
    "session.join": {
      "roles": [
        "agent"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "session_join_input",
      "output": "session_join_output",
      "semantic_guard": "邀请 proof 由认证适配器验证，不只凭 invitation_id；准备成功前不返回 control secret。"
    },
    "session.heartbeat": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "core.session",
      "mode": "lease",
      "input": "session_heartbeat_input",
      "output": "session_heartbeat_output",
      "semantic_guard": "request_id 为 fresh_nonce；相同 ID 不续租；当前 transport_epoch/generation/ready。"
    },
    "session.snapshot": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "core.session",
      "mode": "read",
      "input": "session_snapshot_input",
      "output": "session_snapshot_output",
      "semantic_guard": "同一快照切点返回会话、cursor、可见动作/情境/定义/成员；按当前读权过滤，不返回写凭据，不续租。"
    },
    "session.events": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "core.events",
      "mode": "lease",
      "input": "session_events_input",
      "output": "session_events_output",
      "semantic_guard": "request_id 为 poll_nonce；cursor 绑定 session/epoch；冻结及当前受众双检查，重复不续租。"
    },
    "session.close": {
      "roles": [
        "companion_control",
        "player",
        "game"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "session_close_input",
      "output": "session_close_output",
      "semantic_guard": "按主体关闭权验证；game 仅走管理入口；closed 不复活，保留已授权结果。"
    },
    "session.resume": {
      "roles": [
        "agent"
      ],
      "lane": "control",
      "feature": "resume",
      "mode": "control",
      "input": "session_resume_input",
      "output": "session_resume_output",
      "semantic_guard": "fresh 原主体、持久账本和未过期租约；同设备，控制回执先于 expected_generation 重试检查。"
    },
    "session.handoff": {
      "roles": [
        "player"
      ],
      "lane": "control",
      "feature": "handoff",
      "mode": "control",
      "input": "session_handoff_input",
      "output": "session_handoff_output",
      "semantic_guard": "玩家决定绑定目标；先撤旧代写权；玩家只取 transfer 状态，不能取得 agent secret。"
    },
    "session.claim_control": {
      "roles": [
        "agent"
      ],
      "lane": "control",
      "feature": "handoff",
      "mode": "control",
      "input": "session_claim_control_input",
      "output": "session_claim_control_output",
      "semantic_guard": "仅 transfer 中原 agent+已验证目标设备，ready/当前代次/未撤销；未 ready 返回 pending；闭会或后续升代不回放旧 secret。"
    },
    "operation.get": {
      "roles": [
        "agent",
        "player"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "read",
      "input": "operation_get_input",
      "output": "operation_get_output",
      "semantic_guard": "同主体/受众查询；control/lease 用原 request_id，action.request/cancel 用 Envelope.id。done 是原请求完成，不等于当前仍可写或动作成功；动作视图重验结果读权；无秘密、不执行或赎领。"
    },
    "chat.send": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "core.events",
      "mode": "message",
      "input": "chat_send_input",
      "output": "chat_send_output",
      "semantic_guard": "sender 由凭据验证；team 需能力和 expected_membership_revision，受众冻结成员代次。"
    },
    "action.request": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "actions",
      "mode": "message",
      "input": "action_request_input",
      "output": "action_request_output",
      "semantic_guard": "Envelope.id 是 action ID；校验能力 revision/参数/一次确认，在效果临界区再次核权。"
    },
    "action.cancel": {
      "roles": [
        "companion_control"
      ],
      "lane": "data",
      "feature": "actions",
      "mode": "message",
      "input": "action_cancel_input",
      "output": "action_cancel_output",
      "semantic_guard": "仅原 actor；取消收据不证明未发生效果；目标 payload.request_id 不等于取消消息 ID。"
    },
    "action.query": {
      "roles": [
        "results_reader",
        "agent",
        "player",
        "companion_control"
      ],
      "lane": "results",
      "feature": "actions",
      "mode": "read",
      "input": "action_query_input",
      "output": "action_query_output",
      "semantic_guard": "原只读授权/期限/撤销/可见动作；不要求会话写权有效；重新认证原主体不扩大读权。"
    },
    "action.confirm": {
      "roles": [
        "player"
      ],
      "lane": "control",
      "feature": "actions",
      "mode": "control",
      "input": "action_confirm_input",
      "output": "action_confirm_output",
      "semantic_guard": "一次玩家确认绑定 session、action、原请求 ID、参数与定义摘要；不能由 agent 代签。"
    },
    "context.publish": {
      "roles": [
        "game"
      ],
      "lane": "management",
      "feature": "core.events",
      "mode": "message",
      "input": "context_publish_input",
      "output": "context_publish_output",
      "semantic_guard": "只写批准开放类别；game 不续伙伴租约；来源绑定当前共享经历。"
    },
    "player_chat.forward": {
      "roles": [
        "game"
      ],
      "lane": "management",
      "feature": "core.events",
      "mode": "message",
      "input": "player_chat_forward_input",
      "output": "player_chat_forward_output",
      "semantic_guard": "当前 GameAuthority/Scope/成员代次席位证明绑定玩家 sender；按玩家/Envelope.id 去重，不续伙伴租约。"
    },
    "capability.replace": {
      "roles": [
        "game"
      ],
      "lane": "management",
      "feature": "actions",
      "mode": "control",
      "input": "capability_replace_input",
      "output": "capability_replace_output",
      "semantic_guard": "CAS；定义 ID 唯一；新增/改义不扩旧 Grant，执行中旧 fence 失效。"
    },
    "membership.replace": {
      "roles": [
        "game"
      ],
      "lane": "management",
      "feature": "core.events",
      "mode": "control",
      "input": "membership_replace_input",
      "output": "membership_replace_output",
      "semantic_guard": "基础席位也有成员代次；新增队伍席位需 team；重加入增加代次且不扩旧 Scope。"
    },
    "permission.revoke": {
      "roles": [
        "player",
        "game"
      ],
      "lane": "control",
      "feature": "core.session",
      "mode": "control",
      "input": "permission_revoke_input",
      "output": "permission_revoke_output",
      "semantic_guard": "按对象验证撤销权；game 只走管理入口；result_read 单独撤销不伪造不存在。"
    },
    "action.claim": {
      "roles": [
        "executor"
      ],
      "lane": "management",
      "feature": "actions",
      "mode": "control",
      "input": "action_claim_input",
      "output": "action_claim_output",
      "semantic_guard": "worker 必须登记；同控制请求可读原 ticket，ticket/step 仍唯一；新请求不领取已 executing 动作。"
    },
    "action.commit_result": {
      "roles": [
        "executor"
      ],
      "lane": "management",
      "feature": "actions",
      "mode": "control",
      "input": "action_commit_result_input",
      "output": "action_commit_result_output",
      "semantic_guard": "原可信 ticket 只报告事实；terminal 同摘要幂等，冲突拒绝；旧代不能执行新效果。"
    },
    "launch.request": {
      "roles": [
        "player"
      ],
      "lane": "local",
      "feature": "core.session",
      "mode": "control",
      "input": "launch_request_input",
      "output": "launch_request_output",
      "semantic_guard": "固定注册应用，禁止任意命令/路径；单次启动许可与接入批准分开。"
    },
    "asset.resolve": {
      "roles": [
        "resource_owner"
      ],
      "lane": "local",
      "feature": "assets",
      "mode": "control",
      "input": "asset_resolve_input",
      "output": "asset_resolve_output",
      "semantic_guard": "批准来源/依赖闭包/大小/摘要/解析沙箱；不携带会话 secret 下载。"
    },
    "presentation.acquire": {
      "roles": [
        "presentation_authority"
      ],
      "lane": "local",
      "feature": "presentation",
      "mode": "control",
      "input": "presentation_acquire_input",
      "output": "presentation_acquire_output",
      "semantic_guard": "request_id 是 operation_id；绑定当前设备 epoch，初始 lease_revision=1；设备身份/条款/期限/tombstone 校验；重试不延长占用。"
    },
    "presentation.renew": {
      "roles": [
        "presentation_authority"
      ],
      "lane": "local",
      "feature": "presentation",
      "mode": "control",
      "input": "presentation_renew_input",
      "output": "presentation_renew_output",
      "semantic_guard": "仅当前游戏存活租约产生更高 revision；绑定设备 epoch/原条款，不续游戏租约；旧 revision/重试不延长占用，tombstone 不可复活。"
    },
    "presentation.release": {
      "roles": [
        "presentation_authority"
      ],
      "lane": "local",
      "feature": "presentation",
      "mode": "control",
      "input": "presentation_release_input",
      "output": "presentation_release_output",
      "semantic_guard": "仅清理自己的 generation；先写 tombstone，再按最新 baseline 重算，失败报告实际状态。"
    },
    "privacy.request": {
      "roles": [
        "data_subject"
      ],
      "lane": "privacy",
      "feature": "privacy-request",
      "mode": "control",
      "input": "privacy_request_input",
      "output": "privacy_request_output",
      "semantic_guard": "发送实际数据控制者；验证每条来源主体权；仅对可控副本承诺。"
    },
    "privacy.receipt": {
      "roles": [
        "data_subject"
      ],
      "lane": "privacy",
      "feature": "privacy-request",
      "mode": "read",
      "input": "privacy_receipt_input",
      "output": "privacy_receipt_output",
      "semantic_guard": "读取本人已提交请求的当前处理状态；不能由数据主体伪造存储方回执。"
    },
    "relay.register": {
      "roles": [
        "relay_controller"
      ],
      "lane": "relay",
      "feature": "core.session",
      "mode": "control",
      "input": "relay_register_input",
      "output": "relay_register_output",
      "semantic_guard": "角色凭据由验证过的配对渠道分别交付，不把 game/agent/controller 三种 secret 同时交给注册者。"
    },
    "relay.call": {
      "roles": [
        "relay_agent",
        "relay_controller"
      ],
      "lane": "relay",
      "feature": "core.session",
      "mode": "relay",
      "input": "relay_call_input",
      "output": "relay_call_output",
      "semantic_guard": "外层 lane 与内层主体都校验；固定 instance，无任意 URL；重复 call 不延长 deadline；inner reply 按原操作 schema 校验。"
    },
    "relay.pull": {
      "roles": [
        "relay_game"
      ],
      "lane": "relay",
      "feature": "core.session",
      "mode": "control",
      "input": "relay_pull_input",
      "output": "relay_pull_output",
      "semantic_guard": "同 pull_nonce 返回原 claim；claimed 不重入队；凭据仅有领取/回复权限。"
    },
    "relay.reply": {
      "roles": [
        "relay_game"
      ],
      "lane": "relay",
      "feature": "core.session",
      "mode": "control",
      "input": "relay_reply_input",
      "output": "relay_reply_output",
      "semantic_guard": "精确 claim owner；reply 必须通过原 operation 的输出 schema 和 request_id 校验；重复相同结果幂等。"
    },
    "relay.revoke": {
      "roles": [
        "relay_controller"
      ],
      "lane": "relay",
      "feature": "core.session",
      "mode": "control",
      "input": "relay_revoke_input",
      "output": "relay_revoke_output",
      "semantic_guard": "queued 原子关闭可证明本路径未投递；claimed 只能 unknown；作废全部外层凭据但不伪造世界回滚。"
    }
  },
  "features": {
    "core.session": [],
    "core.events": [
      "core.session"
    ],
    "actions": [
      "core.session",
      "core.events"
    ],
    "team": [
      "core.session",
      "core.events"
    ],
    "avatar": [
      "core.session",
      "core.events"
    ],
    "assets": [
      "avatar"
    ],
    "presentation": [
      "core.session",
      "core.events"
    ],
    "resume": [
      "core.session",
      "core.events"
    ],
    "multi-session": [
      "core.session",
      "core.events"
    ],
    "handoff": [
      "resume"
    ],
    "privacy-request": [
      "core.session",
      "core.events"
    ]
  },
  "errors": {
    "unauthenticated": {
      "category": "authentication",
      "retry": "after_reauth",
      "http_status": 401,
      "outcome": "not_accepted"
    },
    "permission_denied": {
      "category": "authorization",
      "retry": "never",
      "http_status": 403,
      "outcome": "not_accepted"
    },
    "invalid_message": {
      "category": "validation",
      "retry": "never",
      "http_status": 400,
      "outcome": "not_accepted"
    },
    "invalid_arguments": {
      "category": "validation",
      "retry": "never",
      "http_status": 400,
      "outcome": "not_accepted"
    },
    "invalid_cursor": {
      "category": "validation",
      "retry": "never",
      "http_status": 400,
      "outcome": "not_accepted"
    },
    "unsupported_media_type": {
      "category": "validation",
      "retry": "never",
      "http_status": 415,
      "outcome": "not_accepted"
    },
    "message_too_large": {
      "category": "limit",
      "retry": "never",
      "http_status": 413,
      "outcome": "not_accepted"
    },
    "unsupported_operation": {
